generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
}

datasource db {
  provider = "postgresql"
}

model assignments {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  customer_id        String?  @db.Uuid
  role               String   @default("developer")
  allocation         Int      @default(0)
  joined             DateTime @default(now()) @db.Date
  linearId String? 

  user     users  @relation("AssignmentUser", fields: [user_id], references: [id])
  customer users? @relation("AssignmentCustomer", fields: [customer_id], references: [id])
}

model customers {
  id                   BigInt   @default(autoincrement()) @db.BigInt
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  proposal_id          String?
  stripe_customer_id   String?
  linear_name          String?
  linear_slug          String?
  email                String? // not needed, should be on user object already
  linear_initiative_id String?
  linear_projects      String[]
  // is this self referential? there's already an id at the top
  customer_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // is this a copy of linear_projects? if so please delete
  project_url          String[]
}

model cycle_metrics {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                   String   @db.Uuid 
  project_id                    String
  cycle_id                      String
  name                          String?
  description                   String?
  number                        Int?
  completed_at                  DateTime? @db.Timestamptz(6)
  scope_history                 Int[]    @default([])
  completed_scope_history       Int[]    @default([])
  uncompleted_issues_upon_close Json     @default(dbgenerated("'[]'::jsonb"))
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
  ends_at                       DateTime? @db.Timestamptz(6)
  is_active                     Boolean?
  starts_at                     DateTime? @db.Timestamptz(6)
  issues_averages               Json[]
  project_name                  String?
  cycle_issue_ids               Json     @default(dbgenerated("'[]'::jsonb"))
}

// Shouldn't need this table. All user_activity can be tracked on a single table if that's needed
