  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id   String
  user_email String
  read_at    DateTime @default(now()) @db.Timestamptz(6)
} */

model decisions {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_id         String
  status           Boolean?
  owner_email      String
  question         String
  // no answers needed
  answers          Json     @default(dbgenerated("'[]'::jsonb"))
  // single decision needed. can be updated. can have a separate field to maintain decision history
  decisions        Json     @default(dbgenerated("'[]'::jsonb"))
  decision         String?
  decision_by      String?
  decided_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  posted_to_linear Boolean  @default(false)
}


model developers {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  user_id           String   @unique @db.Uuid
  policies_approved Boolean? @default(false)
  policy_notion_url String?

  user users @relation("UserDeveloper", fields: [user_id], references: [id])
}

model document {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  file_name  String?
  link       String?
  category   String?
  size       String?
  project_slug String?
  permissions document_permissions[]
  
  // You shouldn't need owner for anything. 
  // You can have a permission for "owner" on document permissions if needed
  owner_id   String?  @db.Uuid
  owner       users? @relation("DocumentOwner", fields: [owner_id], references: [id])
  

  @@map("Document") // should be lowercase like the other tables. also make it plural for convention "documents"
}

model document_permissions {
  id          BigInt @id @default(autoincrement()) @db.BigInt
  user_id     String @db.Uuid
  document_id BigInt @db.BigInt
  permission  String

  document Document @relation(fields: [document_id], references: [id])
}

// rename to dora_metrics
model dorametrics {
  dorametrics_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // where is customer id? should have the same structure as issue_metrics and cycle_metrics in how its referenced
  averages           Json
  cfr_details        Json?
  lead_time_details  Json?
  mttr_details       Json?
  deploy_freq_details Json?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  last_called        DateTime? @db.Timestamptz(6)
  user_id            String?   @db.Uuid // this should be removed in place of customer
  linear_slug        String?
  url                String?

  user users? @relation(fields: [user_id], references: [id])
}


// Is this needed for anything?
// See if you can attach metadata in cometchat itself, delete this table entirely
model issue_chats {
  issue_id          String   @id
  cometchat_group_id String
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  last_message_at   DateTime? @db.Timestamptz(6)
  first_message_text String?
}

model issue_metrics {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String // should be uuid not string if this is a foreign key
  project_id     String
  status         String?
  label          String?
  count          Int?     @default(0)
  points         Decimal? @default(0) @db.Decimal
  cycle          String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  cycle_issue_id String?
  title          String[]
}


// users table should only have details specific to the user, and not to any other objects
// See comments on fields below
model users {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  email             String?
  role              String?  @default("user")
  customer_id       String?
  subscription_id   String?
  project_ids       String[]
  initiative_ids    String[]
  auth_id           String?
  proposal_id       String?
  linear_slug       String? // shouldn't be on a user level, should be on a client object
  linear_projects   String[] // shouldn't be on a user level, should be on a client object
  userName          String?
  assignment_id     String[] // not sure this is needed, should be using an assignment table xref
  clientName        String? // shouldn't be on a user level, should be on a client object
  phoneNumber       String?
  firstName         String?
  lastName          String?
  project_url       String[] // shouldn't be on a user level, should be on a client object
  documents              Document[]     @relation("DocumentOwner")
  developer              developers?    @relation("UserDeveloper")

  // Could you confirm that there's just a single assignments table, and that these keys aren't actually in the table?
  assignments_as_user     assignments[]  @relation("AssignmentUser")
  assignments_as_customer assignments[]  @relation("AssignmentCustomer") 
  dorametrics             dorametrics[] // shouldn't be on a user level, should be on a client object
}


// could you move everything for the marketing site and everything for the portal to separate schemas?
// instead of "public", marketing tables should be under "marketing" and portal tables should be in "portal"
model leads {
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  first_name       String?
  last_name        String?
  email            String?
  description      String?
  budget_min       Decimal? @db.Decimal
  budget_max       Decimal? @db.Decimal
  company          String?
  industry         String?
  selected_date    String?
  selected_time    String?
  lead_id          String   @unique @db.Uuid
  formatted_date   DateTime? @db.Timestamptz(6)
  estimateTime_min Int?
  estimateTime_max Int?
  scheduling_url   String?
  email_sent       Boolean?
  booking_status   String?
  email_sent_at    String?
  discovery_state  String?
  build_scale      String?

  proposals proposals[]
}

model ig_posts {
  blog_id           String   @id @db.Uuid
  title             String
  img               String?
  author            String?
  tags              String[]
  slide_two         String?
  slide_three       String?
  contentful_id     String?  @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  slide_three_title String?
}

model proposals {
  created_at                       DateTime @default(now()) @db.Timestamptz(6)
  passcode                         String   @id
  proposal_id                      String?  @db.Uuid
  stage                            String?
  updated_at                       DateTime? @db.Timestamptz(6)
  lead_id                          String?  @db.Uuid
  creator_email                    String?
  signature_url                    String?
  signed_at                        DateTime? @db.Timestamptz(6)
  summary_items                    Json?
  client_name                      String?
  provider_name                    String?
  proposal_title                   String?
  proposal_date                    DateTime? @db.Date
  valid_until                      DateTime? @db.Date
  signatures                       Json?
  disclaimer                       Json?
  timeline_and_milestones          Json?
  summary                          Json?
  problem_and_context              Json?
  solution_overview                Json?
  pricing_and_commercial           Json?
  objectives_and_success_criteria  Json?
  next_steps                       Json?
  assurance_and_quality            Json?
  risk_and_responsabilities        Json?
  assumptions_and_dependencies     Json?
  change_management_process        Json?
  history_and_case_studies         Json?
  technology_and_architecture      Json?
  team_and_communication           Json?
  deliverables                     Json?
  meetingDate                      String?

  lead         leads?         @relation(fields: [lead_id], references: [lead_id])
  requirements requirements[]
}

model requirements {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  proposal_id      String?  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id    String?
  integration_text String?
  description      String?
  purpose          String?
  feature_name     String?
  tech_constraints String?

  proposal proposals? @relation(fields: [submission_id], references: [passcode])
}
