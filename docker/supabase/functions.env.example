# Edge function secrets for the local Supabase. Copy to functions.env (not in git).
# Fill each empty value with the one the cloud project uses.
# Check them with: node docker/supabase/portal/check-functions-env.mjs
#
# Set by docker-compose.portal.yml, do not add here:
#   PROJECT_URL, SERVICE_SECRET_KEY, APP_URL, VERIFY_JWT
#
# These are PRODUCTION keys: what local functions do in Stripe, Linear,
# Resend or CometChat really happens.

# IA
# supabase/functions/.env has a value that differs from the cloud
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_REASONING_EFFORT=
AI_API_KEY=
# supabase/functions/.env has a value that differs from the cloud
AI_UID=

# Linear
LINEAR_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash
# supabase/functions/.env has a value that differs from the cloud
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# CometChat
COMETCHAT_APP_ID=
COMETCHAT_API_KEY=
COMETCHAT_REGION=

# Contentful
# supabase/functions/.env has a value that differs from the cloud
SPACE_ID=
# supabase/functions/.env has a value that differs from the cloud
CONTENTFULL_ACCESS_TOKEN=
# supabase/functions/.env has a value that differs from the cloud
PREVIEW_TOKEN=

# Mail (Resend / SMTP)
RESEND_KEY=
# supabase/functions/.env has a value that differs from the cloud
FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=

# GitHub / Cal.com
GH_ORG_PAT=
CAL_KEY=

# Test mode
ALLOW_TEST_MODE=
TEST_MODE_TOKEN=
