# Copy this file to .env and fill it in. Used by `npm run dev` and by
# `docker compose up --build` (see README.md → "Running with Docker").
#
# NEXT_PUBLIC_* values end up in the browser's JavaScript: never put a
# secret key in one. In Docker they are baked in when the image is built,
# so rebuild after changing them.

# Required: your Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=<anon / publishable key>

# The portal's public address, used for links (e.g. https://portal.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Stripe payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: CometChat chat
NEXT_PUBLIC_COMET_APP_ID=
NEXT_PUBLIC_COMET_AUTH_KEY=
NEXT_PUBLIC_COMET_ADMIN_UID=
NEXT_PUBLIC_COMET_AI_UID=

# Docker only: the port the portal is served on (default 3000)
# PORT=3000
